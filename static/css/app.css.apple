/*
Медицинский дневник — app.css
Визуальный слой в стиле iPhone OS 1.3 (скевоморфизм: pinstripe-фон, стальные
навбары со стеклянным бликом, глянцевые «гелевые» кнопки Aqua, группированные
списки, физические иконки-плитки, LCD-дисплеи ввода).
ВАЖНО: покрытие селекторов идентично прежней версии — разметка (app.html,
login.html) и app.js не изменяются, функционал сохранён полностью.
Тёмная тема — существующий механизм html.theme-dark (переключатель «Тёмная
тема», localStorage medical_diary_theme): graphite-скевоморфизм.
*/
:root{
  --font:Helvetica,"Helvetica Neue",Arial,sans-serif;
  --bg-base:#cdd3db; --bg-stripe:rgba(255,255,255,.45);
  --text:#1f242b; --muted:#67707c; --faint:#8b93a0; --head:#4c566c;
  --emboss:0 1px 0 rgba(255,255,255,.75);
  --border:#9aa1ab; --line:#d5d9df;
  --row-1:#ffffff; --row-2:#f4f6f8; --group-1:#ffffff; --group-2:#f7f8fa;
  --field-bg:#ffffff; --field-bd:#8f959e;
  --primary:#2f6fe4; --primary-strong:#1b4fa8; --primary-soft:#dce8fb;
  --success:#2b8229; --success-soft:#dff3de; --warning:#c96a08; --warning-soft:#fdeeda;
  --danger:#c22f2f; --danger-soft:#fadddd;
  --bar-1:#b6bdc6; --bar-2:#8d95a0; --bar-3:#6f7883; --bar-4:#59616c;
  --bar-line:#3d434c; --bar-text:#ffffff; --bar-ts:0 -1px 0 rgba(0,0,0,.55);
  --sheet-1:#8d95a0; --sheet-2:#6f7883; --sheet-3:#59616c;
  --gelb-1:#8ec4fb; --gelb-2:#4a90e2; --gelb-3:#2e7cd6; --gelb-4:#1e63b4; --gelb-bd:#1b4fa8;
  --gelg-1:#fdfdfd; --gelg-2:#d9dde3; --gelg-3:#c3c9d1; --gelg-4:#a9b0ba; --gelg-bd:#5a616b; --gelg-text:#20242b;
  --gelr-1:#ffb3ab; --gelr-2:#e35d5d; --gelr-3:#cf3c3c; --gelr-4:#a82626; --gelr-bd:#8e1f1f;
  --geln-1:#8bd487; --geln-2:#379635; --geln-3:#2b8229; --geln-4:#1f6b1e; --geln-bd:#1c5c1b;
  --gelo-1:#ffd28a; --gelo-2:#f08c1e; --gelo-3:#d97a10; --gelo-4:#b36208; --gelo-bd:#8a4c06;
  --gloss-top:linear-gradient(180deg,rgba(255,255,255,.5),rgba(255,255,255,.08));
  --gel-blue:linear-gradient(180deg,var(--gelb-1),var(--gelb-2) 48%,var(--gelb-3) 52%,var(--gelb-4));
  --gel-gray:linear-gradient(180deg,var(--gelg-1),var(--gelg-2) 48%,var(--gelg-3) 52%,var(--gelg-4));
  --gel-red:linear-gradient(180deg,var(--gelr-1),var(--gelr-2) 48%,var(--gelr-3) 52%,var(--gelr-4));
  --gel-green:linear-gradient(180deg,var(--geln-1),var(--geln-2) 48%,var(--geln-3) 52%,var(--geln-4));
  --gel-orange:linear-gradient(180deg,var(--gelo-1),var(--gelo-2) 48%,var(--gelo-3) 52%,var(--gelo-4));
  --lcd-bg:linear-gradient(180deg,#0c1116,#1a222b 60%,#0c1116);
  --lcd-text:#8ff0ff; --lcd-glow:rgba(80,220,255,.7);
  --shadow:0 1px 3px rgba(0,0,0,.28); --shadow-deep:0 2px 6px rgba(0,0,0,.35);
  --radius:10px; --tab-active:#9fd0ff;
}
html.theme-dark{
  --bg-base:#17191c; --bg-stripe:rgba(255,255,255,.05);
  --text:#f2f4f7; --muted:#9aa0a8; --faint:#7d838c; --head:#c8cdd4;
  --emboss:0 -1px 0 rgba(0,0,0,.8);
  --border:#0b0c0e; --line:#33373d;
  --row-1:#2e3237; --row-2:#26292d; --group-1:#2a2d32; --group-2:#232629;
  --field-bg:#1d2023; --field-bd:#0a0b0c;
  --primary:#3d8bff; --primary-strong:#7db4ff; --primary-soft:#12325a;
  --success:#37b534; --success-soft:#0d3426; --warning:#f0932b; --warning-soft:#392c14;
  --danger:#ff5d5d; --danger-soft:#3a1822;
  --bar-1:#3a3d42; --bar-2:#232629; --bar-3:#1a1c1f; --bar-4:#101214; --bar-line:#000;
  --sheet-1:#2b2e33; --sheet-2:#1f2226; --sheet-3:#191b1e;
  --gelg-1:#4a4e55; --gelg-2:#33373c; --gelg-3:#2b2e33; --gelg-4:#202327; --gelg-bd:#0c0d0f; --gelg-text:#f2f4f7;
  --gloss-top:linear-gradient(180deg,rgba(255,255,255,.22),rgba(255,255,255,.04));
  --shadow:0 1px 3px rgba(0,0,0,.6); --shadow-deep:0 2px 8px rgba(0,0,0,.65);
}
*,:before,:after{box-sizing:border-box}
html,body{min-height:100%}
[hidden]{display:none!important}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.55;cursor:wait}
body{
  margin:0;color:var(--text);font-family:var(--font);-webkit-text-size-adjust:100%;
  background-color:var(--bg-base);
  background-image:repeating-linear-gradient(90deg,var(--bg-stripe) 0 1px,rgba(0,0,0,0) 1px 3px);
  padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  overscroll-behavior-x:none;
}
img{border:1px solid rgba(0,0,0,.45);border-radius:14px;box-shadow:0 2px 5px rgba(0,0,0,.4),inset 0 1px 1px rgba(255,255,255,.4)}

/* ========== Гелевые кнопки Aqua (общий шаблон) ========== */
.button,.primary-action,.admin-action,.med-btn.primary,
.preset-btn.active,.segmented input:checked+label,
.button-group input:checked+label,.chips input:checked+label,
.header-action,.close-btn,.icon-btn,.med-btn,.pdf-btn,.date-btn,
.preset-btn,.filter-toggle,.quick-repeat,.cell-actions button,
.time-row .med-btn,.backup-restore-btn{
  position:relative;border-radius:9px;font-weight:700;
  background-image:var(--gloss-top),var(--gel-gray);
  background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;
  border:1px solid var(--gelg-bd);color:var(--gelg-text);
  text-shadow:0 1px 0 rgba(255,255,255,.35);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.5),inset 0 -1px 0 rgba(0,0,0,.18),var(--shadow);
}
html.theme-dark .button,html.theme-dark .primary-action,html.theme-dark .admin-action,
html.theme-dark .med-btn.primary,html.theme-dark .preset-btn.active,
html.theme-dark .segmented input:checked+label,html.theme-dark .button-group input:checked+label,
html.theme-dark .chips input:checked+label,html.theme-dark .header-action,
html.theme-dark .close-btn,html.theme-dark .icon-btn,html.theme-dark .med-btn,
html.theme-dark .pdf-btn,html.theme-dark .date-btn,html.theme-dark .preset-btn,
html.theme-dark .filter-toggle,html.theme-dark .quick-repeat,
html.theme-dark .cell-actions button,html.theme-dark .time-row .med-btn{
  text-shadow:0 -1px 0 rgba(0,0,0,.5);
}
.button,.primary-action,.admin-action,.med-btn.primary,
.preset-btn.active,.segmented input:checked+label,
.button-group input:checked+label,.chips input:checked+label{
  background-image:var(--gloss-top),var(--gel-blue);
  border-color:var(--gelb-bd);color:#fff;text-shadow:0 -1px 0 rgba(0,0,0,.4);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.55),inset 0 -1px 0 rgba(0,0,0,.25),var(--shadow);
}
.button:active,.primary-action:active,.admin-action:active,.med-btn:active,
.preset-btn:active,.date-btn:active,.close-btn:active,.icon-btn:active{transform:scale(.97);filter:brightness(.94)}
.icon-btn.delete,.backup-restore-btn{
  background-image:var(--gloss-top),var(--gel-red);
  border-color:var(--gelr-bd);color:#fff;text-shadow:0 -1px 0 rgba(0,0,0,.4);
}

/* ========== Каркас ========== */
.app-shell{width:100%;max-width:760px;margin:0 auto;padding-bottom:100px}
.topbar{
  position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;
  gap:12px;padding:10px 14px;
  background-image:var(--gloss-top),linear-gradient(180deg,var(--bar-1),var(--bar-2) 49%,var(--bar-3) 50%,var(--bar-4));
  background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;
  border-bottom:1px solid var(--bar-line);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 2px 6px rgba(0,0,0,.35);
}
.brand{min-width:0}
.eyebrow{font-size:12px;font-weight:650;color:rgba(255,255,255,.75);margin-bottom:2px;text-shadow:var(--bar-ts)}
.brand-title{font-size:20px;line-height:1.1;font-weight:850;letter-spacing:-.4px;color:var(--bar-text);text-shadow:var(--bar-ts)}
.link-btn{border:0;background:transparent;color:var(--primary-strong);font-size:13px;font-weight:800;padding:0}
.user-pill{max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:rgba(255,255,255,.8);font-size:12px;font-weight:700;text-shadow:var(--bar-ts)}
.header-action{width:42px;height:42px;font-size:20px}
main{width:100%;padding:10px 14px 18px}
.page-intro{margin:12px 2px 16px}
.page-intro h1,.history-head h1{margin:0;font-size:30px;line-height:1.05;letter-spacing:-.8px;text-shadow:var(--emboss)}
.page-intro p{margin:6px 0 0;color:var(--muted);font-size:13px;text-shadow:var(--emboss)}
.section-label{display:flex;align-items:center;justify-content:space-between;margin:18px 2px 8px}
.section-label strong{font-size:14px;letter-spacing:.3px;color:var(--head);text-shadow:var(--emboss)}
.section-label span{font-size:13px;color:var(--primary-strong);font-weight:750;text-shadow:var(--emboss)}

/* ========== Быстрая запись: домашний экран с плитками ========== */
.quick-list{display:grid;grid-template-columns:repeat(4,1fr);gap:16px 10px;padding:4px 2px 8px}
.quick-card{
  display:flex;flex-direction:column;align-items:center;gap:6px;width:100%;min-height:0;
  padding:0;border:0;background:transparent;box-shadow:none;text-align:center;
  -webkit-appearance:none;appearance:none;color:var(--text);
}
.quick-card:active{transform:scale(.96)}
.quick-icon,.history-icon{
  position:relative;display:grid;place-items:center;overflow:hidden;
  border:1px solid rgba(0,0,0,.45);
  box-shadow:0 2px 5px rgba(0,0,0,.4),inset 0 1px 1px rgba(255,255,255,.5);
  background-image:var(--gloss-top),linear-gradient(180deg,#e8edf3,#aeb6c0 55%,#8a939e);
  background-size:100% 52%,100% 100%;background-repeat:no-repeat,no-repeat;
}
.quick-icon{width:57px;height:57px;flex:0 0 57px;border-radius:12px;font-size:30px}
.history-icon{width:29px;height:29px;flex:0 0 29px;border-radius:7px;font-size:16px}
.quick-icon span,.history-icon span,.quick-icon,.history-icon{filter:drop-shadow(0 1px 1px rgba(0,0,0,.45))}
.quick-icon.glucose,.history-icon.glucose{background-image:var(--gloss-top),linear-gradient(180deg,#7fc4ff,#1668c7 55%,#0d4f9e)}
.quick-icon.vitals,.history-icon.vitals{background-image:var(--gloss-top),linear-gradient(180deg,#ff9aa8,#e0335c 55%,#b01e44)}
.quick-icon.temperature,.history-icon.temperature{background-image:var(--gloss-top),linear-gradient(180deg,#ffd28a,#f08c1e 55%,#c96a08)}
.quick-icon.weight,.history-icon.weight{background-image:var(--gloss-top),linear-gradient(180deg,#c9b8ff,#7a5cff 55%,#5a3ad0)}
.quick-icon.food,.history-icon.food{background-image:var(--gloss-top),linear-gradient(180deg,#9df0b6,#1fae62 55%,#0d8a49)}
.quick-copy{min-width:0;display:flex;flex-direction:column;align-items:center}
.quick-title{display:block;font-size:11px;line-height:1.15;font-weight:700;text-shadow:var(--emboss);overflow-wrap:break-word;max-width:100%}
.quick-sub,.chevron{display:none}

/* ========== Последние записи и сводка ========== */
.recent-list{display:grid;gap:0;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);background:var(--group-1)}
.recent-card{display:flex;align-items:center;gap:10px;padding:10px 12px;border-top:1px solid var(--line);background-image:linear-gradient(180deg,var(--row-1),var(--row-2))}
.recent-card:first-child{border-top:0}
.recent-copy{min-width:0;flex:1}
.recent-title{font-size:14px;font-weight:800}
.recent-value{margin-top:2px;font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recent-time{font-size:11px;color:var(--faint);align-self:flex-start;font-weight:700}
.day-summary{display:grid;grid-template-columns:repeat(3,1fr);margin-top:10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--group-1);overflow:hidden;box-shadow:var(--shadow)}
.day-stat{padding:10px 6px;text-align:center;border-left:1px solid var(--line);border-top:1px solid var(--line);background-image:linear-gradient(180deg,var(--row-1),var(--row-2))}
.day-stat:nth-child(3n+1){border-left:0}
.day-stat:nth-child(-n+3){border-top:0}
.day-stat .num{font-size:18px;font-weight:850}
.day-stat .label{margin-top:2px;font-size:10px;color:var(--muted)}

/* ========== Карточки, поля, списки ========== */
.card{
  background-image:linear-gradient(180deg,var(--group-1),var(--group-2));
  border:1px solid var(--border);border-radius:var(--radius);padding:14px;
  margin-bottom:12px;box-shadow:var(--shadow);overflow:hidden;
}
.flat{box-shadow:none}
label{display:block;margin:12px 0 5px;font-size:12px;font-weight:800;color:var(--head);text-shadow:var(--emboss)}
input,select,textarea{
  display:block;width:100%;min-height:44px;border:1px solid var(--field-bd);border-radius:8px;
  background:var(--field-bg);color:var(--text);padding:8px 10px;font-size:16px;outline:none;
  box-shadow:inset 0 1px 3px rgba(0,0,0,.22);
}
input:focus,select:focus,textarea:focus{border-color:var(--primary);box-shadow:inset 0 1px 3px rgba(0,0,0,.22),0 0 4px rgba(47,111,228,.55)}
textarea{min-height:76px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.row>div{min-width:0}
.muted{color:var(--muted);font-size:13px;line-height:1.45}
.message{margin-top:8px;font-size:13px;line-height:1.35}
.ok{color:var(--success);font-weight:700}
.error{color:var(--danger);font-weight:700}

/* ========== Segment control / chips / presets ========== */
.segmented,.button-group,.chips{display:flex;border:1px solid var(--gelb-bd);border-radius:8px;overflow:hidden;box-shadow:var(--shadow)}
.segmented{display:grid;grid-template-columns:1fr 1fr}
.button-group{display:grid;grid-template-columns:1fr 1fr}
.chips{display:grid;grid-template-columns:repeat(7,1fr)}
.segmented input,.button-group input,.chips input{position:absolute;opacity:0;pointer-events:none;width:1px;height:1px}
.segmented label,.button-group label,.chips label{
  display:flex;align-items:center;justify-content:center;min-height:42px;margin:0;padding:6px 4px;
  font-size:13px;font-weight:700;color:var(--gelg-text);text-shadow:0 1px 0 rgba(255,255,255,.35);
  border-left:1px solid var(--gelg-bd);
  background-image:var(--gloss-top),var(--gel-gray);
  background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;
}
html.theme-dark .segmented label,html.theme-dark .button-group label,html.theme-dark .chips label{text-shadow:0 -1px 0 rgba(0,0,0,.5)}
.segmented label:first-of-type,.button-group label:first-of-type,.chips label:first-of-type{border-left:0}
.segmented input:checked+label,.button-group input:checked+label,.chips input:checked+label{
  color:#fff;text-shadow:0 -1px 0 rgba(0,0,0,.4);
  background-image:var(--gloss-top),var(--gel-blue);
  box-shadow:inset 0 2px 5px rgba(0,0,0,.35);
}
.preset-row{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}
.preset-btn{min-height:36px;font-size:12px;font-weight:800}
.date-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.date-btn{position:relative;display:flex;align-items:center;gap:7px;min-height:42px;margin:0;padding:8px 10px;font-size:13px;overflow:hidden}
.date-btn input{position:absolute;inset:0;opacity:0;min-height:0;margin:0;box-shadow:none}
.date-val{color:var(--primary-strong);white-space:nowrap;font-weight:800}
.history-toolbar-row{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:9px}
.history-select label{margin:0 0 5px}
.export-row{margin-top:9px}
.export-row .button{margin:0}
.button{display:block;width:100%;min-height:46px;font-size:14px;font-weight:800}
.primary-action{width:100%;min-height:52px;margin-top:12px;border:1px solid var(--gelb-bd);border-radius:9px;font-size:16px;font-weight:800}
#entry-modal .primary-action{width:auto;min-width:200px;max-width:78%;min-height:56px;margin:16px auto 4px;display:block;border-radius:9px;padding:0 30px}
#entry-modal textarea{min-height:56px}
#entry-modal .bp-field input{min-height:46px;font-size:34px}
#entry-modal .bp-field{padding:10px}
#entry-modal label{margin-top:8px}
.quick-repeat{width:100%;min-height:44px;margin-top:10px;color:var(--primary-strong);font-weight:750}
.field-hint{margin:5px 0 0;color:var(--muted);font-size:11px;text-shadow:var(--emboss)}

/* ========== Тумблер (классический iOS) ========== */
.switch-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:50px;margin:5px 0;font-size:14px;font-weight:700}
.switch-row input{position:absolute;opacity:0;width:1px;height:1px}
.switch{width:77px;height:28px;border-radius:14px;border:1px solid var(--gelg-bd);position:relative;flex:0 0 auto;
  background:linear-gradient(180deg,#dcdfe3,#c2c6cc);box-shadow:inset 0 1px 3px rgba(0,0,0,.35)}
html.theme-dark .switch{background:linear-gradient(180deg,#191b1e,#101214)}
.switch:before{content:"ВКЛ";position:absolute;left:10px;top:6px;font-size:11px;font-weight:800;color:#fff;text-shadow:0 -1px 0 rgba(0,0,0,.35);opacity:0}
.switch:after{content:'';position:absolute;top:1px;left:1px;width:24px;height:24px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#fff,#d9d9d9 60%,#bfbfbf);
  border:1px solid #8c8c8c;box-shadow:0 2px 4px rgba(0,0,0,.4),inset 0 1px 0 #fff;transition:left .18s}
.switch-row input:checked+.switch{background-image:var(--gloss-top),var(--gel-green);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;border-color:var(--geln-bd)}
.switch-row input:checked+.switch:before{opacity:1}
.switch-row input:checked+.switch:after{left:50px}
.rem-switch{margin:0 0 0 auto;min-height:44px}

/* ========== LCD-дисплеи ввода ========== */
.metric-hero{padding:12px;border:1px solid var(--border);border-radius:12px;margin-bottom:12px;
  background-image:var(--gloss-top),var(--gel-gray);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;
  box-shadow:var(--shadow)}
.metric-hero label{margin:0 0 6px}
.metric-input,.bp-field{position:relative;display:flex;align-items:baseline;gap:10px;overflow:hidden;
  background:var(--lcd-bg);border:1px solid #05080c;border-radius:10px;padding:8px 12px;
  box-shadow:inset 0 2px 8px #000,0 1px 0 rgba(255,255,255,.4)}
.metric-input:after,.bp-field:after{content:"";position:absolute;left:0;right:0;top:0;height:45%;
  background:linear-gradient(rgba(255,255,255,.14),rgba(255,255,255,.02));pointer-events:none}
.metric-input input{border:0;background:transparent;padding:0;min-height:56px;height:56px;box-shadow:none;
  font-family:"Courier New",monospace;font-size:44px;font-weight:700;letter-spacing:-1px;line-height:1;
  color:var(--lcd-text);text-shadow:0 0 7px var(--lcd-glow)}
.metric-unit{font-size:15px;font-weight:800;color:var(--lcd-text);opacity:.85}
.metric-status{margin-top:10px}
.vitals-entry{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.bp-field{display:block;padding:10px 12px}
.bp-field .bp-caption{font-size:11px;color:rgba(143,240,255,.75);font-weight:700}
.bp-field input{margin-top:4px;min-height:48px;padding:0;border:0;background:transparent;box-shadow:none;
  font-family:"Courier New",monospace;font-size:34px;font-weight:700;color:var(--lcd-text);text-shadow:0 0 6px var(--lcd-glow)}
.pulse-field{margin-top:10px}
.food-line{padding:10px 12px;border:1px solid var(--field-bd);border-radius:8px;background:var(--field-bg);box-shadow:inset 0 1px 3px rgba(0,0,0,.22)}

/* ========== Модальные окна (sheet со стальной рамкой) ========== */
.modal{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.55);display:flex;align-items:flex-end;justify-content:center;padding:0}
.modal-panel{
  width:100%;max-width:760px;max-height:94vh;overflow:auto;
  background-image:var(--gloss-top),linear-gradient(180deg,var(--sheet-1),var(--sheet-2) 60%,var(--sheet-3));
  background-size:100% 40%,100% 100%;background-repeat:no-repeat,no-repeat;
  border:1px solid var(--bar-line);border-bottom:0;border-radius:14px 14px 0 0;
  padding:10px 14px calc(20px + env(safe-area-inset-bottom));
  box-shadow:0 -18px 50px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.35);
}
.modal-grabber{width:42px;height:5px;border-radius:10px;margin:2px auto 12px;
  background:linear-gradient(90deg,#6d747c,#cdd2d8, #6d747c);box-shadow:0 1px 1px rgba(0,0,0,.5)}
.modal-head{display:flex;align-items:center;gap:11px;margin-bottom:12px}
.modal-title{flex:1;min-width:0}
.modal-title h2{margin:0;font-size:20px;letter-spacing:-.4px;color:#fff;text-shadow:var(--bar-ts)}
.modal-title p{margin:3px 0 0;color:rgba(255,255,255,.8);font-size:12px;text-shadow:var(--bar-ts)}
.close-btn{width:40px;height:40px;font-size:22px}
.edit-title{font-size:18px;font-weight:850;margin-bottom:8px;text-shadow:var(--emboss)}

/* ========== История ========== */
.history-head{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:8px 2px 14px}
.history-count{margin-top:5px;color:var(--success);font-size:13px;font-weight:800;text-shadow:var(--emboss)}
.filter-toggle{min-height:38px;padding:0 12px}
.history-filters{padding:12px}
.filter-title{font-size:11px;font-weight:800;color:var(--head);margin-bottom:8px;text-shadow:var(--emboss);letter-spacing:.4px;text-transform:uppercase}
.legend{margin-bottom:10px;color:var(--muted);font-size:11px;line-height:1.4}
.trend-chart-wrap{position:relative;padding:12px;margin:10px 0;border:1px solid #9aa1ab;border-radius:10px;background:#fff;box-shadow:var(--shadow);overflow:hidden}
.trend-chart-wrap:after{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(160deg,rgba(255,255,255,.5) 0%,rgba(255,255,255,.08) 42%,rgba(255,255,255,0) 43%)}
.trend-chart-title{font-size:13px;font-weight:800;margin-bottom:6px;color:#39404b}
.trend-chart-wrap canvas{display:block;width:100%;height:150px}
.chart-legend{margin:4px 0 0;color:#666;font-size:10px}
.history-cards{display:grid;gap:8px}
.history-day-title{display:flex;align-items:center;gap:7px;margin:14px 2px 4px;font-size:16px;font-weight:850;color:var(--head);text-shadow:var(--emboss)}
.day-chip{padding:3px 8px;border-radius:999px;border:1px solid var(--border);font-size:10px;font-weight:750;color:var(--muted);
  background-image:var(--gloss-top),var(--gel-gray);background-size:100% 50%,100%,100% 100%;background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat}
.history-entry{position:relative;min-width:0;padding:10px 52px 10px 11px;border:1px solid var(--border);border-radius:var(--radius);
  background-image:linear-gradient(180deg,var(--row-1),var(--row-2));box-shadow:var(--shadow);overflow:hidden}
.history-entry-top{display:flex;align-items:center;gap:8px;min-width:0}
.history-entry-main{min-width:0;flex:1}
.history-entry-title{font-size:14px;font-weight:850;line-height:1.15}
.history-entry-meta{margin-top:2px;color:var(--muted);font-size:11px;white-space:nowrap}
.history-value{display:flex;align-items:baseline;gap:7px;margin:8px 0 5px;min-width:0}
.history-value .number{font-size:30px;font-weight:900;letter-spacing:-1px}
.history-value .unit{font-size:12px;font-weight:800;color:var(--muted)}
.status-badge{position:relative;display:inline-flex;align-items:center;gap:3px;padding:4px 8px;border:1px solid;border-radius:999px;
  font-size:10px;font-weight:800;line-height:1.1;white-space:nowrap;color:#fff;text-shadow:0 -1px 0 rgba(0,0,0,.35);overflow:hidden;
  background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat}
.status-badge:after{content:"";position:absolute;left:0;right:0;top:0;height:50%;background:linear-gradient(rgba(255,255,255,.4),rgba(255,255,255,.05));pointer-events:none}
.status-ok{border-color:var(--geln-bd);background-image:var(--gloss-top),var(--gel-green)}
.status-low,.status-high{border-color:var(--gelr-bd);background-image:var(--gloss-top),var(--gel-red)}
.comment-line{margin-top:6px;padding-top:6px;border-top:1px solid var(--line);color:var(--muted);font-size:11px;line-height:1.3;overflow-wrap:anywhere}
.history-actions{position:absolute;top:10px;right:8px;display:flex;flex-direction:column;gap:5px}
.icon-btn{width:34px;height:34px;padding:0;font-size:15px;box-shadow:var(--shadow)}
.vitals-values{display:grid;grid-template-columns:minmax(0,1.25fr) 1px minmax(0,.75fr);gap:9px;align-items:center;margin-top:8px}
.vitals-divider{width:1px;height:56px;background:linear-gradient(180deg,transparent,var(--line),transparent)}
.vital-label{color:var(--muted);font-size:12px;font-weight:750}
.pressure-number{margin-top:2px;font-size:26px;font-weight:900;letter-spacing:-.8px;white-space:nowrap}
.pressure-unit,.pulse-unit{margin-top:1px;color:var(--muted);font-size:11px;font-weight:650}
.vital-statuses{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;margin-top:7px}
.vital-status-item{min-width:0}
.vital-status-item .status-badge{max-width:100%;overflow:hidden}
.vital-caption{margin-top:2px;color:var(--muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ai-dynamics-summary{margin:2px 0 8px;font-size:13px;line-height:1.45}
.ai-dynamics-observations{margin:0 0 8px;padding-left:18px;font-size:12px;line-height:1.5}
.ai-dynamics-observations li{margin:3px 0}
.ai-dynamics-caution{margin:0 0 8px;padding:8px 10px;border:1px solid var(--gelr-bd);border-radius:9px;color:#fff;font-size:12px;font-weight:700;line-height:1.4;
  background-image:var(--gloss-top),var(--gel-red);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;text-shadow:0 -1px 0 rgba(0,0,0,.4)}

/* ========== Таблицы (админ) ========== */
.admin-action{display:flex;align-items:center;justify-content:center;width:100%;min-height:48px;margin:10px 0 12px;padding:10px 14px;font-size:14px;font-weight:800}
.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--border);border-radius:var(--radius);background:var(--group-1);box-shadow:var(--shadow)}
#users-table,#backup-table{width:100%;border-collapse:collapse;table-layout:fixed;min-width:520px}
#users-table th,#users-table td,#backup-table th,#backup-table td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle;font-size:13px;line-height:1.25}
#users-table th,#backup-table th{background-image:var(--gloss-top),linear-gradient(180deg,var(--bar-1),var(--bar-3));background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;
  font-size:12px;font-weight:800;color:#fff;text-shadow:var(--bar-ts);white-space:nowrap}
#users-table tr:last-child td,#backup-table tr:last-child td{border-bottom:0}
#users-table th:nth-child(1),#users-table td:nth-child(1){width:34%}
#users-table th:nth-child(2),#users-table td:nth-child(2){width:42%}
#users-table th:nth-child(3),#users-table td:nth-child(3){width:24%;text-align:right}
.cell-actions{display:flex;justify-content:flex-end;align-items:center;gap:6px;white-space:nowrap}
.cell-actions button{width:38px;height:38px;padding:0;font-size:16px;display:inline-grid;place-items:center}
.cell-actions .del-btn{color:#fff;background-image:var(--gloss-top),var(--gel-red);border-color:var(--gelr-bd)}
#backup-table{min-width:620px}
#backup-table th:nth-child(1),#backup-table td:nth-child(1){width:43%;word-break:break-word}
#backup-table th:nth-child(2),#backup-table td:nth-child(2){width:22%;white-space:nowrap}
#backup-table th:nth-child(3),#backup-table td:nth-child(3){width:13%;white-space:nowrap}
#backup-table th:nth-child(4),#backup-table td:nth-child(4){width:22%;text-align:right;white-space:nowrap}
.backup-restore-btn{min-height:38px;padding:8px 11px;font-size:12px;font-weight:800}
.admin-section details>summary{padding:2px 0 12px;font-weight:800;color:var(--head);text-shadow:var(--emboss)}
.admin-section form{margin-bottom:14px}
.admin-section .table-wrap{margin-top:10px}

/* ========== Настройки ========== */
.settings-section{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
.settings-title{font-size:15px;font-weight:850;margin-bottom:7px;color:var(--head);text-shadow:var(--emboss)}
.about-note{font-size:13px;line-height:1.5}
.about-note h3{font-size:15px;margin:16px 0 5px}
.about-note p,.about-note li{margin:6px 0}
.about-note ul,.about-note ol{padding-left:20px}
.range-row{display:grid;grid-template-columns:minmax(0,1fr) 70px 70px;gap:7px;align-items:center;margin:7px 0}
.range-row span{font-size:12px}
.range-row input{min-height:38px;padding:5px 6px;font-size:13px}

/* ========== Tab bar: чёрное стекло ========== */
.tab-bar{
  position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;gap:6px;
  padding:7px 10px calc(7px + env(safe-area-inset-bottom));
  background:linear-gradient(180deg,#4c4c4c 0%,#1a1a1a 45%,#000 46%);
  border-top:1px solid #000;box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 -4px 12px rgba(0,0,0,.5);
}
.tab-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:54px;
  border:1px solid transparent;border-radius:9px;background:transparent;color:#c9cdd2;font-size:11px;font-weight:800;text-shadow:0 -1px 0 #000}
.tab-btn .tab-icon{width:46px;height:27px;display:grid;place-items:center;font-size:19px;line-height:1;border:1px solid transparent;border-radius:7px}
.tab-btn.active{background:transparent;border-color:transparent;color:var(--tab-active)}
.tab-btn.active .tab-icon{border-color:var(--gelb-bd);background-image:var(--gloss-top),var(--gel-blue);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 1px 3px #000}

/* ========== Toast ========== */
#toast{position:fixed;left:12px;right:12px;z-index:200;top:calc(env(safe-area-inset-top) + 9px);display:flex;justify-content:center;pointer-events:none}
#toast .toast-bubble{max-width:94%;padding:10px 14px;border-radius:12px;font-size:13px;font-weight:800;color:#fff;text-align:center;opacity:0;transform:translateY(-10px);transition:.2s;
  text-shadow:0 -1px 0 rgba(0,0,0,.35);box-shadow:var(--shadow-deep);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat}
.toast-bubble.show{opacity:1!important;transform:translateY(0)!important}
.toast-bubble.ok{border:1px solid var(--geln-bd);background-image:var(--gloss-top),var(--gel-green)}
.toast-bubble.error{border:1px solid var(--gelr-bd);background-image:var(--gloss-top),var(--gel-red)}

/* ========== PDF-просмотр ========== */
#pdf-overlay{position:fixed;inset:0;z-index:100;background:#525659;display:flex;flex-direction:column;
  padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
.pdf-toolbar{display:flex;align-items:center;gap:7px;padding:8px 10px;border-bottom:1px solid #999;
  background-image:var(--gloss-top),linear-gradient(180deg,#fff,#d9dde3);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat}
.pdf-title{flex:1;min-width:0;font-weight:700;font-size:16px;color:#20242b;text-shadow:0 1px 0 rgba(255,255,255,.6)}
.pdf-btn{width:auto;min-height:42px;line-height:40px;margin:0;padding:0 10px;font-size:18px}
.pdf-pages{flex:1}
.pdf-status{color:#fff;text-align:center;padding:24px;font-size:16px}
#zoom-label{min-width:48px;text-align:center;font-weight:700;font-size:14px;color:#333}
#pdf-pages{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;padding:10px}
#pdf-pages canvas{display:block;margin:0 auto 10px;background:#fff;border-radius:3px;box-shadow:0 1px 4px rgba(0,0,0,.4)}

/* ========== Лекарства и напоминания ========== */
.meds-list{display:flex;flex-direction:column;gap:10px}
.med-card{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;align-items:start;padding:12px;
  border:1px solid var(--border);border-radius:var(--radius);background-image:linear-gradient(180deg,var(--row-1),var(--row-2));box-shadow:var(--shadow)}
.med-card.inactive{opacity:.65}
.med-time{min-width:56px;font-size:20px;font-weight:850;letter-spacing:-.4px}
.med-body{min-width:0}
.med-body-wide{grid-column:1 / -1}
.med-name{font-size:16px;font-weight:800;overflow-wrap:anywhere}
.med-sub{margin-top:2px;font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.med-badge{position:relative;display:inline-block;margin-top:6px;padding:3px 10px;border:1px solid var(--gelg-bd);border-radius:999px;
  font-size:12px;font-weight:800;color:var(--gelg-text);overflow:hidden;
  background-image:var(--gloss-top),var(--gel-gray);background-size:100% 50%,100% 100%;background-repeat:no-repeat,no-repeat}
.med-badge.taken{color:#fff;border-color:var(--geln-bd);background-image:var(--gloss-top),var(--gel-green);text-shadow:0 -1px 0 rgba(0,0,0,.35)}
.med-badge.skipped{color:var(--muted)}
.med-badge.unmarked{color:#fff;border-color:var(--gelo-bd);background-image:var(--gloss-top),var(--gel-orange);text-shadow:0 -1px 0 rgba(0,0,0,.35)}
.med-actions{grid-column:1 / -1;display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:8px}
.med-btn{min-height:44px;min-width:44px;padding:0 16px;font-size:14px;font-weight:800}
.meds-subhead{margin:8px 2px 0;font-size:11px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:var(--head);text-shadow:var(--emboss)}
.meds-legend{margin:8px 2px 0}
.med-hist{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;padding:10px 0;border-top:1px solid var(--line)}
.med-hist-time{min-width:56px;font-size:13px;font-weight:800;color:var(--muted)}
.meds-history-card .meds-list{margin-top:10px}
.times-list{display:flex;flex-direction:column;gap:8px;margin-bottom:8px}
.time-row{display:flex;align-items:center;gap:8px}
.time-row input{flex:1}
.time-row .med-btn{flex:0 0 auto;padding:0}
.danger-link{display:block;width:100%;margin-top:14px;text-align:center;color:var(--danger);font-size:14px;font-weight:700}
.push-card .med-actions{margin-top:10px}
.push-card .field-hint{margin-top:10px}
html.theme-dark #med-modal input,html.theme-dark #rem-modal input,html.theme-dark #intake-modal input{color-scheme:dark}

/* ========== Адаптив ========== */
@media(min-width:520px) and (max-width:699px){
  .quick-list{grid-template-columns:repeat(4,1fr)}
}
@media(min-width:700px){
  main{padding-left:20px;padding-right:20px}
  .quick-list{grid-template-columns:repeat(5,1fr)}
  .history-cards{grid-template-columns:1fr 1fr}
  .history-day-title{grid-column:1/-1}
}
@media(max-width:430px){
  .history-toolbar-row{grid-template-columns:1fr}
  .date-grid{grid-template-columns:1fr 1fr}
  .preset-row{grid-template-columns:repeat(4,1fr)}
  .vitals-values{gap:8px}
  .pressure-number{font-size:24px}
  .vital-statuses{gap:4px}
  .status-badge{font-size:10px;padding:4px 6px}
  .range-row{grid-template-columns:minmax(0,1fr) 62px 62px}
  .day-summary{grid-template-columns:repeat(3,1fr)}
  .metric-input input{font-size:38px}
}